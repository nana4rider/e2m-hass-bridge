{
  "name": "e2m-hass-bridge",
  "version": "1.15.3",
  "author": "nana4rider",
  "license": "ISC",
  "main": "dist/index.js",
  "type": "module",
  "homepage": "https://github.com/nana4rider/e2m-hass-bridge",
  "scripts": {
    "dev": "tsx --env-file=.env src/index.ts",
    "start": "node dist/index",
    "build": "node build.js",
    "type-check": "tsc",
    "lint": "eslint --max-warnings 0 && prettier . --check",
    "lint:fix": "eslint --fix && prettier . --write",
    "format:test-json": "prettier 'tests/**/*.json' --write --ignore-path /dev/null",
    "test": "vitest --run",
    "prepare": "husky"
  },
  "lint-staged": {
    "*.ts": [
      "eslint --max-warnings 0",
      "prettier --check"
    ],
    "*.{js,json,md,yml,yaml}": "prettier --check"
  },
  "dependencies": {
    "envalid": "^9.0.0",
    "mqtt": "^5.16.1",
    "winston": "^3.19.0"
  },
  "devDependencies": {
    "@esbuild-plugins/tsconfig-paths": "^0.1.2",
    "@eslint/js": "^10.0.1",
    "@types/node": "^24.19.2",
    "@vitest/coverage-v8": "^5.0.5",
    "@vitest/eslint-plugin": "^1.6.28",
    "echonetlite2mqtt": "github:banban525/echonetlite2mqtt#v3.7.3",
    "esbuild": "^0.28.2",
    "eslint": "^10.13.0",
    "glob": "^13.0.6",
    "globals": "^17.13.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.6.0",
    "prettier": "^3.9.10",
    "tsx": "^4.23.15",
    "type-fest": "^5.10.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.0",
    "vite-tsconfig-paths": "^6.1.1",
    "vitest": "^5.0.5"
  }
}
